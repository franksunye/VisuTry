{
  "name": "visutry",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:skip-prisma": "next dev",
    "dev:test": "next dev --port 3001",
    "mail": "tsx scripts/mail.ts",
    "refund:payment": "tsx scripts/refund-payment.ts",
    "build": "prisma generate && bash scripts/migrate-deploy.sh && next build",
    "build:ci": "prisma generate && next build",
    "build:cloudflare:next": "prisma generate && CLOUDFLARE_BUILD=1 next build",
    "build:cloudflare": "npm run build:cloudflare:next && opennextjs-cloudflare build --skipNextBuild",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy --env staging",
    "deploy:cloudflare:production": "opennextjs-cloudflare deploy --env production",
    "ci:cloudflare:build": "npm run build:cloudflare",
    "ci:cloudflare:deploy:staging": "wrangler deploy --env staging --keep-vars",
    "ci:cloudflare:deploy:production": "wrangler deploy --env production --keep-vars",
    "ci:cloudflare:preview:production": "wrangler versions upload --env production",
    "b4:routes:print": "tsx cloudflare-router/print-b4-production-routes.ts",
    "b4:snapshot-vercel-next": "tsx cloudflare-router/b4-static-asset-parity.ts --snapshot",
    "b4:asset-parity": "tsx cloudflare-router/b4-static-asset-parity.ts",
    "b4:fail-open:assert": "tsx cloudflare-router/b4-fail-open-remote.ts",
    "b4:dns:diff": "tsx cloudflare-router/b4-dns-zone-diff.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:seed:store": "tsx scripts/seed-store-luna.ts",
    "db:seed:pilot": "tsx scripts/seed-store-pilot.ts",
    "db:seed:visutry-demo": "tsx scripts/seed-store-visutry-demo.ts",
    "pilot:preflight": "tsx scripts/pilot-preflight.ts",
    "pilot:check-urls": "tsx scripts/pilot-check-urls.ts",
    "pilot:verify": "tsx scripts/pilot-verify.ts",
    "pilot:route-smoke": "tsx scripts/pilot-route-smoke.ts",
    "pilot:qa": "tsx scripts/pilot-qa.ts",
    "test:mode": "cp .env.test .env.local && npm run dev",
    "test:integration": "node scripts/test-integration.js",
    "test:start": "bash scripts/start-test-mode.sh",
    "test:start:windows": "scripts/start-test-mode.bat",
    "test": "node tests/scripts/run-all-tests.js",
    "test:all": "node tests/scripts/run-all-tests.js all",
    "test:unit": "jest tests/unit --testTimeout=30000",
    "test:unit:ci": "jest tests/unit --runInBand --testTimeout=30000",
    "test:critical:ci": "jest tests/unit/components/face-analysis/FaceAnalysisGate.test.tsx tests/unit/components/face-analysis/FaceAnalysisInterface.test.tsx tests/unit/components/face-analysis/FaceAnalysisCriticalJourney.test.tsx tests/unit/api/face-analysis-submit-critical.test.ts tests/unit/api/payment-face-analysis-unlock-critical.test.ts tests/unit/app/api/payment/webhook-route.test.ts tests/unit/lib/face-analysis-quota-invariants.test.ts --runInBand --testTimeout=30000",
    "qa:pr": "npm run typecheck && npm run test:critical:ci && npm run test:unit:ci && npm run test:e2e:list",
    "test:integration:new": "jest tests/integration --testTimeout=60000",
    "test:api": "jest tests/integration/api --testTimeout=60000",
    "test:gemini": "tsx scripts/test-gemini-connection.ts",
    "test:gemini:tryon": "tsx scripts/test-gemini-tryon.ts",
    "prompt:versions": "tsx scripts/list-try-on-prompt-versions.ts",
    "test:grsai:face-analysis": "tsx scripts/test-grsai-face-analysis.ts",
    "debug:oauth": "node scripts/debug-twitter-oauth.js",
    "debug:logs": "echo 'Visit http://localhost:3000/debug/logs to view logs'",
    "test:e2e": "jest tests/integration/e2e --testTimeout=120000",
    "test:workflows": "jest tests/integration/workflows --testTimeout=90000",
    "test:watch": "jest --watch tests/",
    "test:coverage": "jest --coverage tests/",
    "test:setup": "node tests/scripts/setup-test-env.js",
    "test:cleanup": "node tests/scripts/cleanup.js",
    "test:e2e:playwright": "playwright test",
    "test:e2e:list": "playwright test --list",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:install": "playwright install chromium",
    "test:smoke:production": "node scripts/production-smoke.mjs",
    "test:sponsored:postgres": "bash scripts/test-sponsored-postgres-local.sh",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:patch:skip-tests": "node scripts/release.js patch --skip-tests",
    "release:minor:skip-tests": "node scripts/release.js minor --skip-tests",
    "release:major:skip-tests": "node scripts/release.js major --skip-tests",
    "release:patch:quick": "node scripts/release.js patch --skip-tests --skip-build",
    "release:minor:quick": "node scripts/release.js minor --skip-tests --skip-build",
    "release:major:quick": "node scripts/release.js major --skip-tests --skip-build",
    "version:check": "echo $npm_package_version",
    "version:bump": "npm version --no-git-tag-version",
    "seo:check": "echo 'Checking SEO configuration...' && node -e \"console.log('Site URL:', process.env.NEXT_PUBLIC_SITE_URL || 'Not set')\"",
    "analyze": "ANALYZE=true next build",
    "analyze:server": "BUNDLE_ANALYZE=server next build",
    "analyze:browser": "BUNDLE_ANALYZE=browser next build",
    "perf:test": "node scripts/test-performance.js",
    "perf:test:open": "node scripts/test-performance.js --open"
  },
  "dependencies": {
    "@axiomhq/js": "^1.3.1",
    "@google/generative-ai": "^0.24.1",
    "@mediapipe/tasks-vision": "0.10.35",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.0.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-neon": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@vercel/blob": "^2.6.1",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "https-proxy-agent": "^7.0.6",
    "lucide-react": "^0.294.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.11",
    "next-intl": "^4.4.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^14.25.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.3.6",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.0",
    "@opennextjs/cloudflare": "1.15.1",
    "@playwright/test": "^1.62.0",
    "@prisma/adapter-pg": "^7.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/imap-simple": "^4.2.10",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.18.1",
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.0",
    "imapflow": "^1.0.182",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "mailparser": "^3.7.3",
    "nodemailer": "^6.10.1",
    "playwright": "^1.62.0",
    "prisma": "^7.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.3.3",
    "wrangler": "^4.123.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.0"
  }
}
