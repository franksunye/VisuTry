# Database
# Explicit runtime identity. Use local / preview / production; do not infer
# this value from a database URL in operator tooling.
APP_ENV="local"
# IMPORTANT: Prisma migrations MUST use a DIRECT (unpooled) connection when
# the configured PostgreSQL pooler uses transaction mode. Such poolers can
# break Prisma's session-level advisory lock and cause P1002 timeouts.
#
# Pooled/runtime connection:
DATABASE_URL="postgresql://username:password@pooler.provider.example/dbname?sslmode=require"
#
# Direct/admin connection — used by Prisma CLI (migrate deploy / status / dev):
DATABASE_URL_UNPOOLED="postgresql://username:password@db.provider.example/dbname?sslmode=require"

# Non-secret database marker used by guarded Preview/Local QA bootstrap.
# Preview and Production identities must remain environment-specific.
# VISUTRY_DATABASE_IDENTITY="local:127.0.0.1:5433/visutry_local"

# Note: A deployment/database integration may provide the following variables automatically:
# - DATABASE_URL (pooled connection)
# - DATABASE_URL_UNPOOLED (direct connection for migrations)
# - POSTGRES_URL, POSTGRES_PRISMA_URL, etc.
# You don't need to manually configure these in Vercel.

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Remote MCP OAuth resource identifier. Set explicitly per environment:
# local: http://localhost:3000/api/mcp
# preview/staging: https://<environment-host>/api/mcp
# production: https://www.visutry.com/api/mcp
MCP_RESOURCE_URL="http://localhost:3000/api/mcp"

# Auth0 OAuth (required)
# Configure Twitter, Google, and other connections in Auth0 dashboard
AUTH0_ID="your-auth0-client-id"
AUTH0_SECRET="your-auth0-client-secret"
AUTH0_ISSUER_BASE_URL="https://your-domain.auth0.com"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# Immutable try-on prompt release (see: npm run prompt:versions)
TRY_ON_PROMPT_VERSION="tryon-v1"

# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_monthly_..."
STRIPE_PREMIUM_YEARLY_PRICE_ID="price_yearly_..."
STRIPE_CREDITS_PACK_PRICE_ID="price_credits_..."

# Merchant G4-B billing. Keep Merchant billing in test mode for local and
# preview environments; production must use STRIPE_MERCHANT_BILLING_MODE=live
# with a live Stripe secret and live Price IDs. Missing mapping fails closed.
STRIPE_MERCHANT_BILLING_MODE="test"
STRIPE_MERCHANT_LAUNCH_MONTHLY_PRICE_ID="price_merchant_launch_..."
STRIPE_MERCHANT_GROWTH_MONTHLY_PRICE_ID="price_merchant_growth_..."
STRIPE_MERCHANT_SCALE_MONTHLY_PRICE_ID="price_merchant_scale_..."
STRIPE_FOUNDING_PILOT_PRICE_ID="price_founding_pilot_..."
# Optional comma-separated registry of previously verified Founding Pilot
# Price IDs. Keep old IDs here when rotating the current Pilot Price.
STRIPE_FOUNDING_PILOT_PRICE_HISTORY=""

# File Upload (Vercel Blob or other storage)
BLOB_READ_WRITE_TOKEN="your-blob-token"
# Defaults to private. Use public-poc only for controlled D0 demos with temporary assets.
STORE_ASSET_ACCESS_MODE="private"
# Current production Face Analysis storage is public. Set to private only after
# the connected Vercel Blob store has been migrated to private access.
# FACE_ANALYSIS_BLOB_ACCESS_MODE="private"
# FACE_ANALYSIS_BLOB_STORE_ID="store_..."

# App Configuration
FREE_TRIAL_LIMIT=3

# ========== Pricing Configuration ==========
# Subscription Quotas
MONTHLY_QUOTA=30
YEARLY_QUOTA=420

# Credits Pack
CREDITS_PACK_AMOUNT=10

# Prices (in cents)
MONTHLY_PRICE=899      # $8.99
YEARLY_PRICE=8999      # $89.99
CREDITS_PACK_PRICE=299 # $2.99

# SEO Configuration
NEXT_PUBLIC_SITE_URL="https://www.visutry.com"
GOOGLE_SITE_VERIFICATION="your-google-verification-code"
YANDEX_VERIFICATION="your-yandex-verification-code"
YAHOO_VERIFICATION="your-yahoo-verification-code"

# Analytics
# Use exactly one public bootstrap. Never put a GA4 measurement ID (G-XXXX)
# in NEXT_PUBLIC_GTM_ID — that double-loads the same property.
# A real GTM container is GTM-XXXX and is loaded instead of gtag.js.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID=""
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
GOOGLE_TAG_MANAGER_ID="GTM-XXXXXXX"

# Optional rebuildable analytics event plane. PostgreSQL remains authoritative
# for all business and user state. Set explicitly; never infer from a hostname.
# When enabled, only analytics-only events are sent best-effort to Turso.
# ANALYTICS_EVENT_PROVIDER="turso"
# TURSO_DATABASE_URL="libsql://your-analytics-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"
# One-time, operator-authorized schema setup only:
# TURSO_ANALYTICS_BOOTSTRAP_AUTHORIZED="1"

# Store abuse protection (not merchant commercial allowance).
# STORE_MERCHANT_DAILY_ATTEMPT_LIMIT="2000"
# STORE_MERCHANT_DAILY_FAILURE_LIMIT="200"

# Cron Jobs Security
CRON_SECRET="your-secure-cron-secret-key"
# Exact MCP Origin allowlist. Production should contain only https://www.visutry.com.
# Local/preview example: http://localhost:3000,https://preview.example.com
MCP_ALLOWED_ORIGINS="http://localhost:3000"
# DCR trusted proxy mode: vercel, cloudflare, or none.
DCR_RATE_LIMIT_TRUSTED_PROXY_MODE="none"

# Optional JS-heavy merchant catalog inspection.
# When enabled, the server calls Cloudflare Browser Rendering only after
# deterministic Shopify/JSON-LD/sitemap/HTML extraction cannot find products.
# Missing credentials or provider failures safely fall back to CSV or Manual.
MERCHANT_BROWSER_RENDERING_ENABLED="false"
CLOUDFLARE_BROWSER_RENDERING_ACCOUNT_ID=""
CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=""
