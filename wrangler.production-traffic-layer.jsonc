{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // This is the production traffic-layer entrypoint. It is intentionally
  // separate from wrangler.jsonc so a repository OpenNext project cannot
  // change the production Worker selected by the deploy command.
  "name": "visutry-cf-staging",
  "main": "cloudflare-router/app-host-worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false,
    "not_found_handling": "none"
  },
  "env": {
    "production": {
      "name": "visutry-cf-production",
      "workers_dev": true,
      // REPO-MANAGED PRODUCTION CONTRACT: keep this exact, reviewed set in
      // sync with the live zone routes. Dashboard edits are emergency-only and
      // must be reconciled here immediately. Vercel remains the sole producer
      // of the Next.js HTML, RSC/Flight, and client asset graph.
      "routes": [
        { "pattern": "www.visutry.com/blog-covers/*", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/assets/*", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/images/*", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/home/*", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/experience-heroes/*", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/favicon.ico", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/robots.txt", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/llms.txt", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/api/health", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/api/glasses/brands", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/api/glasses/categories", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/api/glasses/face-shapes", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/en/blog/ai-face-analysis-for-glasses-guide", "zone_name": "visutry.com" },
        { "pattern": "www.visutry.com/en/brand/gentle-monster", "zone_name": "visutry.com" }
      ],
      "vars": {
        "ROUTER_ENV": "production",
        "NEXTAUTH_URL": "https://www.visutry.com",
        "VERCEL_ORIGIN": "https://visutry.vercel.app",
        "PUBLIC_HOST": "www.visutry.com"
      }
    }
  }
}
