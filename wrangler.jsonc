{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visutry-cf-staging",
  "main": "cloudflare-router/app-host-worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Keep Workers Logs and traces aligned with the dashboard. A deploy
  // without this block would reset dashboard observability.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // Production Worker name lives under env.production. Do NOT list www
  // Worker Routes or custom_domain here. B4.2D attaches exactly 9 ungated
  // P0 routes through the Cloudflare Routes API after deploy. Copying the
  // 286-route review manifest into wrangler would publish P1/P2 by accident.
  // `npm run deploy:cloudflare` remains staging-only.
  // Workers Builds: connect Git to visutry-cf-staging or visutry-cf-production
  // separately. Dashboard Worker name must match wrangler env name. Never add
  // www routes here. Production deploy command must use --env production
  // --keep-vars so existing P0 Routes and secrets are not rewritten.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Asset-first: exact files in .open-next/assets are served without invoking
    // app-host-worker.ts. true would bill hashed JS/CSS/images against the
    // Workers Free 100,000 requests/day quota. Do not enable Workers Caching
    // as a quota offload; cache hits still count as Worker requests and can
    // bill otherwise-free Static Assets.
    "run_worker_first": false,
    "not_found_handling": "none"
  },
  "env": {
    "staging": {
      "name": "visutry-cf-staging",
      "vars": {
        "ROUTER_ENV": "staging",
        "NEXTAUTH_URL": "https://visutry-cf-staging.sunye.workers.dev",
        "VERCEL_ORIGIN": "https://visutry.vercel.app",
        "PUBLIC_HOST": "visutry-cf-staging.sunye.workers.dev"
      }
    },
    "production": {
      "name": "visutry-cf-production",
      "workers_dev": true,
      "vars": {
        "ROUTER_ENV": "production",
        "NEXTAUTH_URL": "https://www.visutry.com",
        "VERCEL_ORIGIN": "https://visutry.vercel.app",
        "PUBLIC_HOST": "www.visutry.com"
      }
    }
  }
}
