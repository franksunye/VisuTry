{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visutry-cf-staging",
  "main": "cloudflare-router/app-host-worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Asset-first: exact files in .open-next/assets are served without invoking
    // app-host-worker.ts. true would bill hashed JS/CSS/images against the
    // Workers Free 100,000 requests/day quota. Do not enable Workers Caching
    // as a quota offload; cache hits still count as Worker requests and can
    // bill otherwise-free Static Assets.
    "run_worker_first": false,
    "not_found_handling": "none"
  },
  "env": {
    "staging": {
      "name": "visutry-cf-staging",
      "vars": {
        "ROUTER_ENV": "staging",
        "NEXTAUTH_URL": "https://visutry-cf-staging.sunye.workers.dev",
        "VERCEL_ORIGIN": "https://visutry.vercel.app",
        "PUBLIC_HOST": "visutry-cf-staging.sunye.workers.dev"
      }
    }
  }
}
