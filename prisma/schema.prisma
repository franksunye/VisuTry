// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The `url` is intentionally omitted here. Prisma 7 resolves it from
  // prisma.config.ts, which forces CLI commands (migrate deploy / status)
  // onto a DIRECT (unpooled) Neon connection to avoid P1002 advisory lock
  // timeouts caused by PgBouncer transaction-mode pooling.
  // Runtime PrismaClient uses @prisma/adapter-neon over the pooled
  // DATABASE_URL — see src/lib/prisma.ts.
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique

  // VisuTry specific fields
  freeTrialsUsed Int      @default(0)  // Free trial uses (for non-premium users)
  premiumUsageCount Int   @default(0)  // Premium subscription usage count (resets on billing cycle)
  creditsPurchased Int    @default(0)  // Total credits purchased (never decreases)
  creditsUsed Int         @default(0)  // Total credits used (never decreases)
  isPremium      Boolean  @default(false)
  premiumExpiresAt DateTime?
  currentSubscriptionType String?      // Current active subscription type (PREMIUM_MONTHLY or PREMIUM_YEARLY)
  role             UserRole @default(USER)

  // Email notification tracking
  lastRetention3DayEmailSent DateTime?  // Track 3-day reminder email
  lastRetention24HEmailSent  DateTime?  // Track 24-hour reminder email
  lastRetentionDeletedEmailSent DateTime?  // Track deletion notification email

  accounts      Account[]
  sessions      Session[]
  tryOnTasks         TryOnTask[]
  faceAnalysisTasks  FaceAnalysisTask[]
  payments           Payment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TryOnTask {
  id          String   @id @default(cuid())
  /// Optional for anonymous Store sessions; required for CONSUMER origin (DB CHECK).
  userId      String?
  type        TryOnType @default(GLASSES)  // Try-on category

  // Input images
  userImageUrl    String
  itemImageUrl    String                   // Generic field for any item
  glassesImageUrl String?                  // Keep for backward compatibility

  // Output
  resultImageUrl  String?

  // Task status
  status      TaskStatus @default(PENDING)
  errorMessage String?
  quotaSettledAt DateTime? // Successful task quota was settled exactly once
  quotaSource    String?   // subscription | credit | free_trial | store_demo | merchant_allowance

  // Actor / tenant attribution (first-class; not metadata-only)
  origin             TryOnOrigin @default(CONSUMER)
  merchantId         String?
  merchantSessionId  String?
  merchantFrameId    String?
  /// Store: store:{session}:{frame}:{clientSubmissionId}; unique when present
  idempotencyKey     String?     @unique

  // Metadata
  prompt             String?
  clientSubmissionId String?
  metadata           Json?

  // Data retention
  expiresAt   DateTime?  // When this task data will be deleted

  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant        Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  merchantSession MerchantSession? @relation(fields: [merchantSessionId], references: [id], onDelete: Restrict)
  merchantFrame   MerchantFrame?  @relation(fields: [merchantFrameId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])                                // Index for type filtering
  @@index([userId, type, createdAt(sort: Desc)]) // Optimized type queries
  @@index([userId, createdAt(sort: Desc)])       // Optimize dashboard recent tasks query
  @@index([userId, status])                      // Optimize dashboard stats query
  @@index([status, quotaSettledAt])               // Reconcile completed but unsettled tasks
  @@index([expiresAt])                           // Index for expiry cleanup cron
  @@index([origin])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([merchantSessionId])
  @@index([merchantFrameId])
  @@unique([userId, clientSubmissionId])          // Prevent duplicate client/batch submissions
}

model FaceAnalysisTask {
  id              String     @id @default(cuid())
  userId          String
  userImageUrl    String
  status          TaskStatus @default(PENDING)
  errorMessage    String?

  detectedShape   String?
  confidence      Float?
  basicResult     Json?
  fullResult      Json?
  reportUnlocked  Boolean    @default(false)

  externalTaskId  String?
  prompt          String?
  metadata        Json?
  expiresAt       DateTime?

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([expiresAt])
  @@index([externalTaskId])
}

model FaceShapeDetection {
  id            String     @id @default(cuid())
  status        TaskStatus
  failureReason String?
  createdAt     DateTime   @default(now())

  @@index([status, createdAt])
  @@index([failureReason, createdAt])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  stripeSessionId       String        @unique
  stripePaymentId       String?       @unique
  stripeSubscriptionId  String?       // Stripe subscription ID for recurring payments

  amount          Int           // Amount in cents
  currency        String        @default("usd")
  status          PaymentStatus @default(PENDING)

  // Product info
  productType     ProductType
  description     String?

  // Acquisition context captured at Checkout creation (landing, source, clusters)
  attribution     Json?

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@index([userId, createdAt(sort: Desc)])
}

model GlassesFrame {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String
  category    String?
  brand       String?
  model       String?
  price       Int?     // Price in cents
  style       String?
  material    String?
  color       String?
  isActive    Boolean  @default(true)

  // 关联
  faceShapes  FrameFaceShapeRecommendation[]
  categories  FrameCategoryAssociation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([brand])
  @@index([category])
  @@index([isActive])
  @@index([style])
  @@index([material])
  @@index([isActive, category])
  @@index([isActive, brand])
  @@index([isActive, createdAt])
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProductType {
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
  CREDITS_PACK
  CREDITS_PACK_PROMO_60
  PREMIUM_MONTHLY_PROMO
  PREMIUM_YEARLY_PROMO
}

enum TryOnType {
  GLASSES
  OUTFIT
  SHOES
  ACCESSORIES
}

model FaceShape {
  id              String   @id @default(cuid())
  name            String   @unique // round, square, oval, etc.
  displayName     String   // "Round Face"
  description     String?
  characteristics String?  // 脸型特征

  frames          FrameFaceShapeRecommendation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GlassesCategory {
  id          String   @id @default(cuid())
  name        String   @unique // prescription, sunglasses, etc.
  displayName String   // "Prescription Glasses"
  description String?

  frames      FrameCategoryAssociation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FrameFaceShapeRecommendation {
  id          String   @id @default(cuid())
  frameId     String
  faceShapeId String
  reason      String?  // 推荐原因

  frame       GlassesFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)
  faceShape   FaceShape    @relation(fields: [faceShapeId], references: [id], onDelete: Cascade)

  @@unique([frameId, faceShapeId])
}

model FrameCategoryAssociation {
  id         String   @id @default(cuid())
  frameId    String
  categoryId String

  frame      GlassesFrame    @relation(fields: [frameId], references: [id], onDelete: Cascade)
  category   GlassesCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([frameId, categoryId])
}

enum UserRole {
  USER
  ADMIN
}

enum TryOnOrigin {
  CONSUMER
  STORE_DEMO
  STORE_PILOT
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum MerchantFrameStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum MerchantFrameSource {
  SEED
  MANUAL
  CSV
  EXTERNAL
}

enum EnrichmentStatus {
  NOT_REQUIRED
  PENDING
  REVIEW_REQUIRED
  APPROVED
}

enum MerchantSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum MerchantIntentType {
  FAVORITE
  PRODUCT_CLICK
  INQUIRY
}

enum StoreEventSource {
  CLIENT
  SERVER
}

enum StoreAssetPurpose {
  SHOPPER_PHOTO
  FRAME_INPUT
  GENERATED_RESULT
}

enum StoreAssetAccessMode {
  PUBLIC_TEMPORARY
  PRIVATE_SIGNED
}

enum MerchantUsageKind {
  RENDER_ATTEMPT
  RENDER_SUCCESS
  RENDER_FAILURE
  SESSION
}

/// Store tenant boundary.
model Merchant {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  logoUrl      String?
  websiteUrl   String?
  contactEmail String?
  accentColor  String?
  status       MerchantStatus @default(ACTIVE)

  frames   MerchantFrame[]
  sessions MerchantSession[]
  intents  MerchantIntent[]
  events   MerchantEvent[]
  assets   StoreAsset[]
  usage    MerchantUsageLedger[]
  tryOnTasks TryOnTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([updatedAt])
}

/// Merchant-owned catalog listing (separate from global GlassesFrame).
model MerchantFrame {
  id               String              @id @default(cuid())
  merchantId       String
  sku              String?
  name             String
  imageUrl         String?
  imageAssetId     String?
  productUrl       String?
  /// Integer minor currency units — never float.
  price            Int?
  /// Normalized ISO-style lowercase code (e.g. usd).
  currency         String?
  shape            String
  material         String?
  color            String?
  widthClass       String?
  styleTags        String[]            @default([])
  source           MerchantFrameSource @default(SEED)
  externalId       String?
  enrichmentStatus EnrichmentStatus    @default(APPROVED)
  status           MerchantFrameStatus @default(DRAFT)

  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  intents    MerchantIntent[]
  events     MerchantEvent[]
  tryOnTasks TryOnTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, sku])
  @@unique([merchantId, source, externalId])
  @@index([merchantId, status])
  @@index([merchantId, updatedAt])
}

/// Anonymous shopper session scoped to one merchant.
model MerchantSession {
  id                  String                @id @default(cuid())
  merchantId          String
  anonymousVisitorId  String?
  photoAssetId        String?
  /// SHA-256 hex of opaque capability token — never store plaintext.
  capabilityTokenHash String
  locale              String?
  status              MerchantSessionStatus @default(ACTIVE)
  lastActiveAt        DateTime              @default(now())
  expiresAt           DateTime

  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  photoAsset StoreAsset?      @relation("SessionPhotoAsset", fields: [photoAssetId], references: [id], onDelete: SetNull)
  intents    MerchantIntent[]
  events     MerchantEvent[]
  assets     StoreAsset[]     @relation("SessionAssets")
  usage      MerchantUsageLedger[]
  tryOnTasks TryOnTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, status])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([capabilityTokenHash])
}

model MerchantIntent {
  id                String             @id @default(cuid())
  merchantId        String
  merchantSessionId String
  merchantFrameId   String?
  type              MerchantIntentType
  idempotencyKey    String             @unique
  email             String?
  name              String?
  note              String?            @db.Text

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  session  MerchantSession  @relation(fields: [merchantSessionId], references: [id], onDelete: Restrict)
  frame    MerchantFrame?   @relation(fields: [merchantFrameId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([merchantId, type])
  @@index([merchantSessionId])
}

/// Append-only durable Store events (source of truth for merchant insights).
model MerchantEvent {
  id                String           @id @default(cuid())
  eventId           String           @unique
  type              String
  merchantId        String
  merchantSessionId String?
  merchantFrameId   String?
  tryOnTaskId       String?
  source            StoreEventSource
  locale            String?
  deviceType        String?
  /// Sanitized non-sensitive metadata only.
  metadata          Json?

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  session  MerchantSession? @relation(fields: [merchantSessionId], references: [id], onDelete: Restrict)
  frame    MerchantFrame?   @relation(fields: [merchantFrameId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([merchantId, type])
  @@index([merchantSessionId])
  @@index([tryOnTaskId])
}

model StoreAsset {
  id                  String               @id @default(cuid())
  merchantId          String
  merchantSessionId   String?
  ownerType           String
  ownerId             String
  purpose             StoreAssetPurpose
  storageKey          String
  accessMode          StoreAssetAccessMode @default(PUBLIC_TEMPORARY)
  providerUrl         String?
  expiresAt           DateTime
  deletedAt           DateTime?
  deleteFailCount     Int                  @default(0)
  lastDeleteError     String?
  lastDeleteAttemptAt DateTime?

  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  session           MerchantSession?  @relation("SessionAssets", fields: [merchantSessionId], references: [id], onDelete: Restrict)
  sessionsWithPhoto MerchantSession[] @relation("SessionPhotoAsset")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId, purpose])
  @@index([expiresAt, deletedAt])
  @@index([merchantSessionId])
  @@index([storageKey])
  @@index([deletedAt, deleteFailCount, lastDeleteAttemptAt])
}

model MerchantUsageLedger {
  id                String            @id @default(cuid())
  merchantId        String
  merchantSessionId String?
  tryOnTaskId       String?
  kind              MerchantUsageKind

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  session  MerchantSession? @relation(fields: [merchantSessionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([tryOnTaskId, kind])
  @@index([merchantId, kind])
  @@index([merchantId, merchantSessionId, kind])
  @@index([tryOnTaskId])
}
